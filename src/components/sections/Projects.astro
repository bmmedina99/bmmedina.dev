---
import { Image } from 'astro:assets'
import { PROJECTS } from '@/constants'
import Section from '../Section.astro'
import Badge from '../ui/Badge'
import Icon from '../ui/Icon'
---

<Section
  name="Proyectos"
  label="Proyectos destacados"
  divclass="grid md:grid-cols-2 gap-x-4"
>
  {
    PROJECTS.map((project) => (
      <article class="p-4 space-y-4 text-center card">
        <Image
          src={project.image}
          alt={`Proyecto ${project.title}: ${project.subtitle}`}
          widths={[578, 834, 1280]}
          sizes="(min-width: 1060px) 390px, (min-width: 780px) calc(40.77vw - 34px), (min-width: 520px) 398px, calc(98vw - 92px)"
          class="rounded-lg aspect-video"
        />
        <h3
          class={`text-3xl font-bold ${project.gradient} bg-clip-text text-transparent`}
        >
          {project.title}
        </h3>
        <p class="font-semibold text-violet-300 text-pretty">
          {project.subtitle}
        </p>
        <p class="px-4 text-gray-300 text-pretty">{project.description}</p>
        <Badge items={project.technologies} />
        {(project.githubURL || project.demoURL) && (
          <div
            class="flex justify-center gap-4"
            aria-label="Enlaces del proyecto"
          >
            {project.githubURL && (
              <a
                href={project.githubURL}
                target="_blank"
                rel="noopener noreferrer nofollow"
                class={`font-medium text-current btn ${project.gradient} border-none`}
              >
                <Icon name="github" variant="icon" />
                <span>Código</span>
              </a>
            )}
            {project.demoURL && (
              <a
                href={project.demoURL}
                target="_blank"
                rel="noopener noreferrer"
                class="btn"
              >
                <Icon name="website" variant="icon" />
                <span>Demo</span>
              </a>
            )}
          </div>
        )}
      </article>
    ))
  }
</Section>
