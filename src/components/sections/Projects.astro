---
import { Image } from 'astro:assets'
import { PROJECTS } from '@/constants'
import Section from '../Section.astro'
import Badge from '../ui/Badge'
import SvgIcon from '../ui/SvgIcon'
---

<Section
  name="Proyectos"
  label="Proyectos destacados"
  divclass="grid md:grid-cols-2 gap-x-4"
>
  {
    PROJECTS.map((project) => (
      <article class="max-w-md p-6 mx-auto space-y-6 overflow-hidden text-center transition-colors border rounded-md border-rebecca-purple bg-russian-violet/60 hover:border-rebecca-purple">
        <Image
          src={project.image}
          alt={`Proyecto ${project.title}: ${project.subtitle}`}
          widths={[578, 834, 1280]}
          sizes="(max-width: 600px) 100vw, (max-width: 900px) 834px, 1280px"
          class={"rounded-md"}
          width={1280}
          height={720}
        />
            <h3 class={`text-3xl font-bold ${project.gradient} bg-clip-text text-transparent`}>
      {project.title}
    </h3>
    <p class="font-semibold text-violet-300 text-pretty">
      {project.subtitle}
    </p>
        <p class="px-4 text-gray-300 text-pretty">{project.description}</p>
        <Badge items={project.technologies} />
        {(project.githubURL || project.demoURL) && (
        <nav class="flex justify-center gap-4" aria-label="Enlaces del proyecto">
          {project.githubURL && (
            <a
              href={project.githubURL}
              target="_blank"
              rel="noopener noreferrer nofollow"
              class={`font-medium text-white btn ${project.gradient} border-none`}
            >
              <SvgIcon name="github" variant="icon" />
              <span>Código</span>
            </a>
          )}
          {project.demoURL && (
            <a
              href={project.demoURL}
              target="_blank"
              rel="noopener noreferrer"
              class="btn"
            >
              <SvgIcon name="website" variant="icon" />
              <span>Demo</span>
            </a>
          )}
        </nav>
        )}
      </article>
    ))
  }
</Section>
