---
import { Image } from 'astro:assets'
import { projects } from '@/site.config'
import Badge from '../ui/Badge.astro'
import Icon from '../ui/Icon'
import Section from './Section.astro'
---

<Section
  name="Proyectos"
  label="Proyectos destacados"
  class="grid md:grid-cols-2 gap-x-4"
>
  {
    projects.map((project) => (
      <article class="p-4 space-y-4 text-center card">
        <Image
          src={project.image}
          alt={`Proyecto ${project.title}: ${project.subtitle}`}
          class="rounded-lg aspect-video"
          widths={[578, 834, 1280]}
          sizes="(min-width: 1060px) 406px, (min-width: 780px) calc(40.77vw - 18px), (min-width: 420px) calc(100vw - 82px), calc(5vw + 298px)"
          format="avif"
        />
        <h3
          class={`text-3xl font-bold ${project.gradient} bg-clip-text text-transparent font-title`}
        >
          {project.title}
        </h3>
        <p class="font-semibold text-violet-300 text-pretty">
          {project.subtitle}
        </p>
        <p class="px-4 text-gray-300 text-pretty">{project.description}</p>
        <Badge items={project.technologies} />
        {(project.githubURL || project.demoURL) && (
          <div
            class="flex justify-center gap-4"
            aria-label="Enlaces del proyecto"
          >
            {project.githubURL && (
              <a
                href={project.githubURL}
                target="_blank"
                rel="noopener noreferrer nofollow"
                class={`font-medium text-current btn ${project.gradient} border-none`}
              >
                <Icon name="git-github" />
                <span>Código</span>
              </a>
            )}
            {project.demoURL && (
              <a
                href={project.demoURL}
                target="_blank"
                rel="noopener noreferrer"
                class="btn"
              >
                <Icon name="website" />
                <span>Visitar</span>
              </a>
            )}
          </div>
        )}
      </article>
    ))
  }
</Section>
