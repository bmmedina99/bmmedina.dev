---
import { Image } from 'astro:assets'
import { PROFILE } from '@/constants'
import { slugify } from '@/utils'
import Section from '../Section.astro'
import { Badge } from '../ui/Badge'
import Button from '../ui/Button'
import SvgIcon from '../ui/SvgIcon'
---

<Section name="Sobre mí" label="Información personal">
  <div class="grid items-start gap-8 lg:grid-cols-2">
    <div
      class="space-y-4 [&>p]:text-lg [&>p]:text-pretty [&>p>strong]:text-[#c084fc] [&>p>strong]:font-medium"
    >
      <div class="clear-left"></div>
      <Image
        src={PROFILE.image}
        alt="Brandon Medina - Desarrollador Web Full Stack"
        class="float-left object-cover mr-4 profile-img"
        width={192}
        height={192}
      />
      <p>
        <strong>Desarrollador Web Full Stack</strong> con más de
        <strong> 3 años de experiencia autodidacta</strong>. Durante mi
        trayectoria, he aplicado mis conocimientos desarrollando proyectos como
        el sitio web para <strong>Gray Gorilla Fitness</strong> y
        <strong>automatizando tareas con Python</strong>.
      </p>
      <p>
        Disfruto investigar y trabajar de <strong> forma independiente</strong>;
        no obstante, valoro la <strong> colaboración en equipo</strong>. En mi
        puesto actual, <strong>superviso y coordino operadores</strong> durante un
        turno asignado para <strong>asegurar la continuidad del servicio</strong
        >.
      </p>
      <p>
        Si tuviera que describirme en pocas palabras, diría que soy
        <strong>analítico</strong>, <strong>metódico</strong> y
        <strong>resolutivo</strong>. Fuera del ámbito laboral,
        me apasionan el ajedrez y la música clásica, aficiones
        que <strong>potencian mis habilidades blandas.</strong>
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="cv_bmmedina.pdf" download class="btn">
          <SvgIcon name="download" variant="icon" />
          <span>Descagar CV</span>
        </a>
        <Button
          client:visible
          className="btn"
          ariaLabel="Ir a la sección de contacto"
          section="contactame"
        >
          <SvgIcon name="contact" variant="icon" />
          <span>Contáctame</span>
        </Button>
      </div>
    </div>
    <div class="space-y-4">
      <section aria-labelledby="tech-skills-heading">
        <h3
          id="tech-skills-heading"
          class="mb-4 text-xl font-semibold text-[#cbd5e1]"
        >
          Habilidades técnicas
        </h3>
        <ul class="flex flex-wrap justify-center gap-2">
          {
            PROFILE.techSkills.map((tech) => (
              <li class="flex flex-col items-center">
                <SvgIcon
                  name={slugify(tech)}
                  width={48}
                  height={48}
                  variant="skill"
                />
                <p class="mt-2 text-sm">{tech}</p>
              </li>
            ))
          }
        </ul>
      </section>
      <section aria-labelledby="soft-skills-heading">
        <h3
          id="soft-skills-heading"
          class="mb-4 text-xl font-semibold text-[#cbd5e1]"
        >
          Habilidades blandas
        </h3>
        <Badge items={PROFILE.softSkills} />
      </section>
      <section aria-labelledby="education-heading">
        <h3
          id="education-heading"
          class="mb-4 text-xl font-semibold text-[#cbd5e1]"
        >
          Estudios
        </h3>
        <ul class="space-y-4">
          {
            PROFILE.studies.map((study) => (
              <li class="p-4 mb-2 cursor-pointer bg-[#12042d]/60 border border-[#3f007d] rounded-lg">
                <div class="flex items-center justify-between">
                  <h4 class="text-sm font-semibold tracking-wide">
                    <span class="text-[#c084fc]">{study.title}</span> &bull;{" "}
                    {study.institution}
                  </h4>
                </div>
                <time datetime={study.date} class="block text-xs tracking-wide">
                  {study.startDate} - {study.endDate}
                </time>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </div>
</Section>
