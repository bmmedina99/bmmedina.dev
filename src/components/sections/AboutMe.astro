---
import { Image } from 'astro:assets'
import { slugify } from '@/lib/utils'
import { aboutMe } from '@/site.config'
import Badge from '../ui/Badge.astro'
import Icon from '../ui/Icon'
import Section from './Section.astro'
---

<Section
  name="Sobre mí"
  label="Información personal"
  class="grid gap-4 lg:grid-cols-2"
>
  <div class="space-y-4">
    <div class="flex flex-col items-centerw md:block">
      <Image
        src={aboutMe.image}
        alt="Brandon Medina - Desarrollador Web Full Stack"
        class="profile-image"
        width={192}
        height={192}
      />
      <p class="text-lg text-pretty">
        <strong>Desarrollador Web Full Stack</strong> con más de 3 años de experiencia
        especializado en <strong>Next.js</strong>, <strong>Astro</strong>,
        <strong>React</strong> y <strong>Node.js</strong>. Durante mi
        trayectoria, he desarrollado proyectos como el sitio web para Gray
        Gorilla Fitness y automatizado tareas con Python.
      </p>
    </div>
    <p class="text-lg text-pretty">
      Disfruto investigando y trabajando de forma independiente; no obstante,
      aprecio el <span class="text-violet-300">trabajo colaborativo</span>.
      Actualmente, superviso y coordino operadores en un entorno técnico,
      garantizando la continuidad del servicio.
    </p>
    <p class="text-lg text-pretty">
      Si tuviera que describirme en pocas palabras, diría que soy analítico,
      metódico y resolutivo. Fuera del ámbito laboral, me apasionan el
      <span class="text-violet-300">ajedrez y la música clásica</span>,
      aficiones que potencian mis habilidades blandas.
    </p>
    <div class="flex flex-wrap justify-center gap-4">
      <a href="cv_bmmedina.pdf" download class="btn">
        <Icon name="download" />
        <span>Descagar CV</span>
      </a>
      <a
        href="#contactame"
        class="btn"
        aria-label="Ir a la sección de contacto"
      >
        <Icon name="contact" />
        <span>Contáctame</span>
      </a>
    </div>
  </div>
  <div class="relative space-y-4">
    <section aria-labelledby="tech-skills-heading">
      <h3
        id="tech-skills-heading"
        class="mb-4 text-xl font-semibold text-zinc-100"
      >
        Habilidades técnicas
      </h3>
      <ul
        class="grid grid-cols-3 md:grid-cols-5 gap-2 [&>li]:flex [&>li]:flex-col [&>li]:items-center [&>li]:text-center"
      >
        {
          aboutMe.techSkills.map((tech) => (
            <li class="group">
              <Icon
                name={slugify(tech.text)}
                className={`size-12 group-hover:-translate-y-2 transition-all ${tech.color} ${tech.hover}`}
              />
              <p
                class={`select-none mt-2 text-sm font-medium transition-colors ${tech.color} ${tech.hover}`}
              >
                {tech.text}
              </p>
            </li>
          ))
        }
      </ul>
    </section>
    <section aria-labelledby="soft-skills-heading">
      <h3
        id="soft-skills-heading"
        class="mb-4 text-xl font-semibold text-zinc-100"
      >
        Habilidades blandas
      </h3>
      <Badge items={aboutMe.softSkills} />
    </section>
    <section aria-labelledby="education-heading">
      <h3
        id="education-heading"
        class="mb-4 text-xl font-semibold text-zinc-100"
      >
        Estudios
      </h3>
      <ul class="space-y-6">
        {
          aboutMe.studies.map((study) => (
            <li class="p-4 card">
              <h4 class="text-sm font-semibold text-violet-300 mb-2">
                {study.title}
              </h4>
              <p class="text-xs text-slate-300">
                {study.institution} • {study.startDate}-{study.endDate}
              </p>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Section>
