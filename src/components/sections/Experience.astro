---
import { Image } from 'astro:assets'
import techSkills from '@/assets/svg/tech-skills.svg'
import Section from '../Section.astro'
import ExperienceDetails from '../ui/Details'
---

<Section name="Experiencia" label="Experiencia profesional">
  <ExperienceDetails client:visible />
  <Image
    class={"absolute top-0 right-0 object-contain opacity-40"}
    src={techSkills}
    alt={"Ilustración de habilidades técnicas"}
    aria-hidden="true"
    width={600}
    height={600}
  />
</Section>
