---
import { Toaster } from 'sonner'
import Section from '../Section.astro'
import Form from '../ui/Form'
---

<Section name="Contactáme" label="Formulario de contacto">
  <Form client:idle />
  <Toaster
    client:visible
    position="bottom-center"
    richColors
    theme="dark"
    toastOptions={{ style: { textAlign: "center", textWrap: "pretty" } }}
  />
</Section>
