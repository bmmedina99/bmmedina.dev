---
import { slugify } from '@/utils'

const { name, label, divclass } = Astro.props
---

<section
  id={slugify(name)}
  aria-labelledby={slugify(label)}
  aria-label={label}
  class="relative px-6 mt-24 mb-12 md:px-12"
>
  <h2
    id={slugify(label)}
    class="mb-10 text-3xl font-semibold tracking-wide text-center uppercase text-violet-500 md:text-5xl font-title"
  >
    {name}
  </h2>
  <div class:list={["max-w-4xl mx-auto space-y-4", { [divclass]: divclass }]}>
    <slot />
  </div>
</section>
