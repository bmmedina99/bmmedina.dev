---
import { slugify } from '@/utils'

const { name, label } = Astro.props
---

<section
  id={slugify(name)}
  aria-label={label}
  class="relative px-6 mt-24 mb-12 md:px-12"
>
  <div class="z-10 max-w-4xl mx-auto">
    <h2 class="text-[#6347ff] text-3xl md:text-5xl font-semibold font-title tracking-wide mb-10 text-center uppercase">
      {name}
    </h2>
    <slot />
  </div>
</section>
