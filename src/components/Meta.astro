---
import { Font } from 'astro:assets'
import { Schema } from 'astro-seo-schema'
import { configSite } from '@/site.config'
import globalCSS from '@/styles/global.css?inline'

const { title, description } = Astro.props
const siteTitle = `${title} | ${configSite.title}`
const siteURL = new URL(Astro.request.url, Astro.site).toString()
const siteAuthor = configSite.author
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<Font cssVariable="--font-orbitron" />
<Font cssVariable="--font-onest" />
<style set:html={globalCSS}></style>

<title>{siteTitle}</title>
<meta name="description" content={description} />
<meta name="generator" content={Astro.generator} />
<meta name="robots" content="index, follow" />
<meta name="author" content={siteAuthor} />

<meta property="og:title" content={siteTitle} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content="bmmedina.dev" />
<meta property="og:image" content={`${siteURL}images/open-graph.webp`} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:url" content={siteURL} />
<meta property="og:type" content="website" />

<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:title" content={siteTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={`${siteURL}images/twitter-card.webp`} />
<meta property="twitter:url" content={siteURL} />
<meta property="twitter:site" content={`@${siteAuthor}`} />
<meta property="twitter:creator" content={`@${siteAuthor}`} />

<meta name="theme-color" content="#003014" />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="canonical" href={siteURL} />

<Schema
  item={{
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Brandon Medina",
    url: siteURL,
    image: "https://bmmedina.dev/images/profile.webp",
    sameAs: [
      "https://github.com/bmmedina99",
      "https://www.linkedin.com/in/bmmedina99",
      "https://www.instagram.com/bmmedina99",
      "https://www.youtube.com/@bmmedina99",
      "https://x.com/bmmedina99",
      "https://www.facebook.com/bmmedina.dev",
    ],
    jobTitle: "Desarrollador Web Full Stack",
    worksFor: {
      "@type": "Organization",
      name: "Izertis",
    },
    skills: [
      "Next.js",
      "Astro",
      "React",
      "TypeScript",
      "Node.js",
      "NestJS",
      "Python",
      "TaildwindCSS",
      "PostgreSQL",
      "Git & GitHub",
    ],
  }}
/>
