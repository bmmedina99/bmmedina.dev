---
import onestFont from '@fontsource/onest/files/onest-latin-400-normal.woff2?url'
import orbitronFont from '@fontsource/orbitron/files/orbitron-latin-700-normal.woff2?url'
import { Schema } from 'astro-seo-schema'
import globalCSS from '@/styles/global.css?inline'

const canonicalURL = new URL(Astro.request.url, Astro.site).toString()
const { title, description } = Astro.props
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<link
  rel="preload"
  href={orbitronFont}
  as="font"
  type="font/woff2"
  crossorigin="anonymous"
/>
<link
  rel="preload"
  href={onestFont}
  as="font"
  type="font/woff2"
  crossorigin="anonymous"
/>

<style>
  @font-face {
    font-family: "Orbitron";
    font-style: normal;
    font-display: swap;
    font-weight: 600;
    src: url(@fontsource/orbitron/files/orbitron-latin-600-normal.woff2)
      format("woff2");
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA,
      U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191,
      U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: "Orbitron";
    font-style: normal;
    font-display: swap;
    font-weight: 700;
    src: url(@fontsource/orbitron/files/orbitron-latin-700-normal.woff2)
      format("woff2");
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA,
      U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191,
      U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: "Onest";
    font-style: normal;
    font-display: swap;
    font-weight: 400;
    src: url(@fontsource/onest/files/onest-latin-400-normal.woff2)
      format("woff2");
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA,
      U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191,
      U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: "Onest";
    font-style: normal;
    font-display: swap;
    font-weight: 500;
    src: url(@fontsource/onest/files/onest-latin-500-normal.woff2)
      format("woff2");
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA,
      U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191,
      U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: "Onest";
    font-style: normal;
    font-display: swap;
    font-weight: 600;
    src: url(@fontsource/onest/files/onest-latin-600-normal.woff2)
      format("woff2");
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA,
      U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191,
      U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
</style>

<style set:html={globalCSS}></style>

<title>{title}</title>
<meta name="description" content={description} />
<meta name="generator" content={Astro.generator} />
<meta name="robots" content="index, follow" />
<meta name="author" content="Brandon Medina" />

<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content="bmmedina.dev" />
<meta
  property="og:image"
  content="https://bmmedina.dev/images/open-graph.webp"
/>
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:type" content="website" />

<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta
  property="twitter:image"
  content="https://bmmedina.dev/images/twitter-card.webp"
/>
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:site" content="@bmmedina99" />
<meta property="twitter:creator" content="@bmmedina99" />

<meta name="theme-color" content="#003014" />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="canonical" href={canonicalURL} />

<Schema
  item={{
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Brandon Medina",
    jobTitle: "Desarrollador Web Full Stack",
    url: canonicalURL,
    description: description,
    image: "https://bmmedina.dev/images/profile.webp",
    sameAs: [
      "https://github.com/bmmedina99",
      "https://www.linkedin.com/in/bmmedina99/",
      "https://www.instagram.com/bmmedina99/",
      "https://www.youtube.com/@bmmedina99",
      "https://x.com/bmmedina99",
      "https://www.facebook.com/bmmedina99",
    ],
    skills: [
      "Next.js",
      "Astro",
      "React",
      "TypeScript",
      "Node.js",
      "NestJS",
      "Python",
      "TaildwindCSS",
      "PostgreSQL",
      "Git & GitHub",
    ],
  }}
/>
