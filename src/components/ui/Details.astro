---
import { Experiences } from '@/site.config'
import Badge from './Badge.astro'
import Icon from './Icon.tsx'
---

{
  [...Experiences].reverse().map((experience) => (
    <article class="mb-4">
      <button
        type="button"
        class="w-full p-4 text-left card"
        data-id={experience.id}
        aria-expanded="false"
        aria-controls={`experience-detail-${experience.id}`}
        aria-label={`Expandir detalles de ${experience.title} en ${experience.company}`}
      >
        <div>
          <h3 class="text-xl font-semibold text-purple-300">
            {experience.title}
          </h3>
          <div class="flex justify-between w-full">
            <p class="text-gray-300">{experience.company}</p>
            <span class="text-violet-300" aria-hidden="true">
              <Icon
                name="menu-expand"
                className="transform transition-transform duration-300"
              />
            </span>
          </div>
          <time class="text-sm text-gray-400">
            {experience.startDate} - {experience.endDate}
          </time>
        </div>
      </button>
      <div
        id={`experience-detail-${experience.id}`}
        class={`overflow-hidden transition-all duration-300 ease-in-out border rounded-md bg-rebecca-purple/40 border-russian-violet mt-4 p-4`}
        hidden
        role="region"
        aria-labelledby={`btn-${experience.id}`}
      >
        <ul class="pl-4 space-y-2 text-gray-300 list-disc text-pretty">
          {experience.description.map((desc) => (
            <li>{desc}</li>
          ))}
        </ul>
        <Badge items={experience.technologies} />
        <div class="flex flex-wrap justify-between gap-4 text-sm">
          <p class="flex items-center gap-2 text-emerald-200">
            <Icon name="location" />
            <span>{experience.location}</span>
          </p>
          {experience.website && (
            <p class="flex items-center gap-2 text-cyan-200">
              <Icon name="website" />
              <a
                href={experience.website.link}
                target="_blank"
                rel="noopener noreferrer nofollow"
                class="hover:underline"
                aria-label={`Visitar sitio web de ${experience.company}`}
              >
                {experience.website.text}
              </a>
            </p>
          )}
        </div>
      </div>
    </article>
  ))
}
