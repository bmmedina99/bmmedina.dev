---
import { EXPERIENCES_SECTION, HOME_SECTION } from '@/lib/constants'
import Icon from '../ui/Icon'
import Navigation from '../ui/Navigation'
import ScrollToTop from '../ui/ScrollToTop.astro'
---

<header
  id={HOME_SECTION}
  class="relative flex flex-col items-center justify-center overflow-hidden min-h-dvh"
>
  <div
    aria-hidden="true"
    class="absolute overflow-hidden size-150 bg-linear-to-br from-rebecca-purple/40 to-transparent blur-3xl rounded-full animate-pulse"
  >
  </div>
  <section class="z-10 text-center">
    <h1 class="font-bold font-title uppercase text-balance">
      <span
        class="tracking-wide text-transparent bg-linear-to-r from-violet-400 via-sky-400 to-emerald-400 bg-clip-text"
      >
        Brandon
      </span> Medina
      <span class="sr-only"> - Desarrollador Web Full Stack en Madrid</span>
    </h1>
    <p class="max-w-xl mx-auto mb-8 md:text-xl text-pretty">
      Diseño, desarrollo y despliegue de proyectos web desde Tres Cantos
      (Madrid). Más de 3 años creando experiencias
      <span class="text-violet-300">rápidas</span>,
      <span class="text-sky-400">accesibles</span> y con
      <span class="text-emerald-400">propósito</span>.
    </p>
  </section>
  <Navigation client:idle />
  <ScrollToTop />
  <a
    href={`#${EXPERIENCES_SECTION}`}
    class="absolute flex items-center w-6 h-10 border-2 rounded-full bottom-8 border-violet-300 animate-bounce"
    aria-label={`Ir a la sección de ${EXPERIENCES_SECTION}`}
  >
    <Icon name="scroll-down" />
  </a>
</header>
