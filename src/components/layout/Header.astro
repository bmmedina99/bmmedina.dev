---
import { EXPERIENCES_SECTION, HOME_SECTION } from '@/lib/constants'
import Icon from '../ui/Icon'
import Navigation from '../ui/Navigation'
import ScrollToTop from '../ui/ScrollToTop.astro'
---

<header id={HOME_SECTION} class="relative flex flex-col items-center justify-center overflow-x-hidden min-h-dvh">
  <div
    aria-hidden="true"
    class="absolute overflow-hidden size-[600px] bg-linear-to-br from-rebecca-purple/40 to-transparent blur-3xl rounded-full animate-pulse"
  >
  </div>
  <section class="z-10 px-4 text-center uppercase text-balance">
    <h1 class="font-bold font-title">
      Brandon Medina
      <span class="sr-only">- Desarrollador Web Full Stack</span>
    </h1>
    <p class="mb-8 text-lg md:text-xl">
      Desarrollador Web
      <span
        class="tracking-wide text-transparent bg-linear-to-r from-purple-400 via-sky-400 to-emerald-400 bg-clip-text"
      >
        Full&nbsp;Stack,
      </span>
      <span class="text-sky-400">Frontend</span> &amp;
      <span class="text-emerald-400">Backend</span>
    </p>
  </section>
  <Navigation client:idle />
  <ScrollToTop />
  <a
    href={`#${EXPERIENCES_SECTION}`}
    class="absolute flex items-center w-6 h-10 border-4 rounded-full bottom-8 border-sky-400 animate-bounce"
    aria-label={`Ir a la sección de ${EXPERIENCES_SECTION}`}
  >
    <Icon name="scroll-down" />
  </a>
</header>
