---
import { socialLinks } from '@/site.config'
import Icon from '../ui/Icon'
---

<footer
  class="backdrop-blur-md bg-linear-to-r from-indigo-900/40 to-rich-black/20"
>
  <div class="px-4 py-12 space-y-6 text-center">
    <h3 class="mb-2 text-2xl font-bold font-title">Brandon Medina</h3>
    <p class="text-lg text-pretty">
      También puedes contactarme por estos medios
    </p>
    <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-6">
      {
        socialLinks.map((social) => (
          <div class="flex flex-col items-center justify-center">
            <a
              href={social.link}
              target="_blank"
              rel="noopener noreferrer nofollow"
              class="flex items-center justify-center rounded-full size-12 group bg-rebecca-purple/60"
              aria-label={social.name}
            >
              <Icon
                name={social.icon}
                width={32}
                height={32}
                className={`group-hover:-translate-y-1 transition-all ${social.color}`}
              />
            </a>
            <span class="mt-2 text-sm">{social.name}</span>
          </div>
        ))
      }
    </div>
    <p
      class="w-full pt-8 text-sm border-t border-zinc-400/40 text-zinc-400 text-pretty"
    >
      {new Date().getFullYear()}. Diseñado y desarrollado por Brandon Medina.
    </p>
  </div>
</footer>
