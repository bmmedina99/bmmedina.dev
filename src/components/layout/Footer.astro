---
import { slugify } from '@/lib/utils'
import { navLinks, socialLinks } from '@/site.config'
import Icon from '../ui/Icon'
---

<footer
  class="w-full pt-8 pb-10 mt-auto text-center border-t bg-rich-black/60 shadow-rebecca-purple/40 border-rebecca-purple"
>
  <div class="container flex flex-col items-center gap-6 mx-auto">
    <div>
      <p class="text-3xl font-semibold font-title">Brandon Medina</p>
      <p class="mt-4 text-pretty">
        También puedes contactarme por estos medios
      </p>
    </div>
    <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-6">
      {
        socialLinks.map((social) => (
          <div class="flex flex-col items-center group">
            <a
              href={social.link}
              target="_blank"
              rel="noopener noreferrer nofollow"
              aria-label={social.name}
            >
              <span class="flex items-center justify-center mb-2 transition-transform rounded-full size-16 bg-rebecca-purple/40 group-hover:bg-transparent">
                <Icon
                  name={social.icon}
                  className={`size-8 group-hover:size-10 group-hover:-translate-y-2 transition-all ${social.color}`}
                />
              </span>
              <span class={`text-sm transition-colors ${social.color}`}>
                {social.name}
              </span>
            </a>
          </div>
        ))
      }
    </div>
    <span class="w-24 h-px bg-rebecca-purple" aria-hidden="true"></span>
    <nav
      class="flex flex-wrap justify-center text-sm gap-x-4 gap-y-2"
      aria-label="Navegación secundaria"
    >
      {
        navLinks.map((item) => (
          <a
            href={`#${slugify(item.label)}`}
            class="transition-colors border-b hover:text-violet-300 hover:border-violet-300"
          >
            <span class="capitalize">{item.label}</span>
          </a>
        ))
      }
    </nav>
    <address
      class="flex flex-wrap items-center justify-center gap-1 text-xs not-italic"
    >
      <span>{new Date().getFullYear()} bmmedina.</span>
      <span>Diseñado y desarrollado por</span>
      <a
        href="https://github.com/bmmedina99"
        target="_blank"
        rel="noopener noreferrer author"
        class="font-semibold transition-colors text-violet-300 hover:text-mauve-50"
        aria-label="Portfolio de bmmedina"
      >
        @bmmedina99
      </a>
    </address>
  </div>
</footer>
