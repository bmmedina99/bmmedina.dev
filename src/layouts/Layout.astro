---
import StarFieldBackground from '@/components/ui/StarFieldBackground'
import Meta from '../components/Meta.astro'

const { ...meta } = Astro.props
---

<!doctype html>
<html lang="es" class="scroll-smooth scroll-pt-20">
  <head>
    <Meta {...meta} />
  </head>
  <body class="antialiased bg-rich-black text-neutral-100 font-content">
    <slot />
    <StarFieldBackground client:idle/>
  </body>
</html>
