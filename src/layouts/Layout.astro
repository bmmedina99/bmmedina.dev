---
import Meta from '../components/Meta.astro'
import '@fontsource/orbitron/600.css'
import '@fontsource/orbitron/700.css'
import '@fontsource/onest/400.css'
import '@fontsource/onest/500.css'
import '@fontsource/onest/600.css'
import StarFieldBackground from '@/components/ui/StarFieldBackground'

const { ...head } = Astro.props
---

<!doctype html>
<html lang="es">
  <head>
    <Meta {...head} />
  </head>
  <body class="bg-[#030014] text-[#f6f6f6] font-content">
    <main class="flex flex-col w-full h-full overflow-x-hidden">
      <slot />
    </main>
    <StarFieldBackground client:idle/>
  </body>
</html>
<style is:global>
  html {
    @apply scroll-smooth scroll-pt-20;
  }

  ::selection {
    @apply bg-[#6347ff]/40;
  }

  ::-webkit-scrollbar {
    @apply w-3;
  }

  ::-webkit-scrollbar-thumb {
    @apply bg-gradient-to-b from-[#c084fc] via-[#22d2f0] to-[#00ffaa] rounded-md border-4 border-solid border-[#030014];
  }
</style>
