---
import Footer from '@/components/layout/Footer.astro'
import Meta from '../components/Meta.astro'

const { ...meta } = Astro.props
---

<!doctype html>
<html lang="es">
  <head>
    <Meta {...meta} />
  </head>
  <body>
    <a href="#main-content" class="sr-only focus:not-sr-only">
      Ir al contenido principal
    </a>
    <slot />
    <Footer />
  </body>
</html>
