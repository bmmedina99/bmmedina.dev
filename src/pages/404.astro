---
import Layout from '@/layouts/Layout.astro'
---

<Layout title="404 - Página no encontrada | bmmedina">
  <main class="relative flex flex-col items-center justify-center min-h-dvh">
    <div class="z-10 px-4 text-center uppercase text-balance">
      <h1 class="text-4xl font-bold md:text-7xl font-title">
        404
      </h1>
      <p class="my-4 text-lg font-medium md:text-xl text-gray-300 ">
        Lo sentimos, no pudimos encontrar la página que buscas.
      </p>
    </div>
    <a href="/" class="btn">Volver al inicio</a>
  </main>
</Layout>
