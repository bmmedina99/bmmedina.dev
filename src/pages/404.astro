---
import Main from '@/components/layout/Main.astro'
import Layout from '@/layouts/Layout.astro'
---

<Layout title="404 - Página no encontrada">
  <Main class="flex items-center justify-center grow overflow-hidden min-h-dvh">
    <div class="max-w-2xl mx-auto space-y-4 text-center">
      <section class="space-y-4">
        <h1
          class="font-bold text-transparent bg-linear-to-r bg-clip-text from-indigo-200 to-rebecca-purple"
        >
          404
        </h1>
        <h2 class="text-3xl font-semibold font-title text-neutral-200">
          Página no encontrada
        </h2>
        <p
          class="max-w-md mx-auto text-lg leading-relaxed text-indigo-200 text-pretty"
        >
          La página que estás buscando no existe o ha sido movida, pero no te
          preocupes, hay muchas otras cosas increíbles que puedes explorar.
        </p>
      </section>
      <div class="flex items-center justify-center">
        <button type="button" onclick="window.history.back()" class="btn">
          Volver a la página anterior
        </button>
      </div>
    </div>
  </Main>
</Layout>
