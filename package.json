    "@emailjs/browser": "5.0.3",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.0",
    "astro-robots-txt": "1.0.0",
    "astro-seo-schema": "7.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
